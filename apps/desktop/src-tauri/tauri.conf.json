{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Website Manager",
  "version": "0.1.0",
  "identifier": "com.teleschirm.website-manager",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Website Manager",
        "width": 960,
        "height": 720,
        "minWidth": 640,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["tsweb"],
        "name": "Website-Paket",
        "description": "Website Manager package",
        "role": "Viewer"
      }
    ]
  }
}
